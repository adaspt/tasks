# Not a secret. A web OAuth client id is public by design — it ends up in the
# JS bundle either way — and is protected by the authorized JavaScript origins
# configured on the client, not by being hidden. Committing it keeps local and
# CI builds identical. Override in .env.local if you ever need a different one.
VITE_GOOGLE_CLIENT_ID=604708647169-g1qknpd8rvaiq2revd28ncrt2u48q5pk.apps.googleusercontent.com
