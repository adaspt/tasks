{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "//": "Client-side routing: /today and friends are not files. The service worker's navigateFallback only helps once it is installed, so the first visit to a deep link needs this.",
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "Hashed filenames, so these can never go stale.",
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "//": "The service worker and the shell must revalidate every time, or a deploy never reaches an installed app.",
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/registerSW.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
